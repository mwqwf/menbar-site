{
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "https://cdn.jsdelivr.net/gh/mwqwf/menbar-site@171249b5088e83569ffaa8a9945e80ee8e5ef724/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/lesson/[^/]+/?$",
      "dest": "/lesson.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}
