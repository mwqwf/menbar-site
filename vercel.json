{
  "version": 2,
  "builds": [
    {
      "src": "api/transcode.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "memory": 1024,
        "includeFiles": "node_modules/{ffmpeg-static,ffprobe-static}/**"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "quran/**"
      }
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/catalog/?$",
      "dest": "/api/catalog.js"
    },
    {
      "src": "^/api/transcode/?$",
      "dest": "/api/transcode.js"
    },
    {
      "src": "^/audio/([0-9a-f]{64})\\.ogg$",
      "dest": "/api/audio.js"
    },
    {
      "src": "^/v1/(.*)$",
      "dest": "/api/proxy.js"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap.js"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "https://cdn.jsdelivr.net/gh/mwqwf/menbar-site@72fc90a1bc170f72d353e55805b67abef4cee11c/assets/$1"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/robots.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy.html"
    },
    {
      "src": "^/admin-privacy/?$",
      "dest": "/admin-privacy.html"
    },
    {
      "src": "^/admin-delete/?$",
      "dest": "/admin-delete.html"
    },
    {
      "src": "^/delete-account/?$",
      "dest": "/admin-delete.html"
    },
    {
      "src": "^/data-deletion/?$",
      "dest": "/admin-delete.html"
    },
    {
      "src": "^/quran/?$",
      "dest": "/api/quran.js"
    },
    {
      "src": "^/quran/[0-9]{1,3}/?$",
      "dest": "/api/quran.js"
    },
    {
      "src": "^/lesson/[^/]+/?$",
      "dest": "/api/render.js"
    },
    {
      "src": "^/category/[^/]+/?$",
      "dest": "/api/render.js"
    },
    {
      "src": "^/section/[^/]+/?$",
      "dest": "/api/render.js"
    },
    {
      "src": "^/$",
      "dest": "/api/render.js"
    }
  ]
}